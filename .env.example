# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

# OpenWeatherMap (free plan): https://home.openweathermap.org/api_keys
# Used only by server.py, so the key never reaches the browser.
OPENWEATHER_API_KEY=replace-with-your-openweathermap-key

# Fallback place if the browser does not share location (City,CountryCode)
WEATHER_CITY=New York,US

# PostHog project key. This one is public by design (it is also in docs/index.html),
# so it is safe to keep here. US region.
POSTHOG_KEY=phc_wbjcMJSVoSfzzTotbd7g4NN2AYmUvEPK8c8atAoRMj7N
POSTHOG_HOST=https://us.i.posthog.com

# Not used yet (no AI model in the app so far)
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
